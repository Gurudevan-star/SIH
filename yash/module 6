def test_exact_transaction_reconstruction():

    engine = CryptoTraceEngine()

    engine.build_graph(
        [
            make_tx(
                "tx1",
                "ethereum",
                "A",
                "B",
            ),
            make_tx(
                "tx2",
                "ethereum",
                "B",
                "C",
            ),
        ]
    )

    result = engine.find_paths(
        ("ethereum", "A"),
        ("ethereum", "C"),
        max_hops=2,
    )

    assert len(result["paths"]) == 1

    path_id = result["paths"][0]["path_id"]

    evidence = engine.get_transaction_path(
        path_id
    )

    assert evidence["hop_count"] == 2

    assert [
        edge["transaction_id"]
        for edge in evidence["edges"]
    ] == [
        "tx1",
        "tx2",
    ]

    assert [
        edge["transaction_hash"]
        for edge in evidence["edges"]
    ] == [
        "hash-tx1",
        "hash-tx2",
    ]


