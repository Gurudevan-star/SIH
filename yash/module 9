class RiskAttributionFrontendAdapter:
    """
    Converts the engine result into explicit UI evidence layers.

    This makes it difficult for a frontend to accidentally present
    intelligence as a blockchain fact.
    """

    @staticmethod
    def present(
        assessment: Mapping[str, Any],
    ) -> Dict[str, Any]:

        risk = assessment[
            "risk_assessment"
        ]

        attribution = assessment[
            "attribution_assessment"
        ]

        return {
            "risk_panel": {
                "title": "RISK ASSESSMENT",
                "score": risk[
                    "risk_score"
                ],
                "level": risk[
                    "risk_level"
                ],
                "explanation": risk[
                    "explanation"
                ],
                "disclaimer": (
                    "Risk indicates analytical indicators "
                    "warranting investigator attention. "
                    "It does not prove fraud or criminal activity."
                ),
            },

            "attribution_panel": {
                "title": "ATTRIBUTION ASSESSMENT",
                "confidence": attribution[
                    "attribution_confidence"
                ],
                "level": attribution[
                    "attribution_level"
                ],
                "proposed_attributions": (
                    attribution[
                        "proposed_attributions"
                    ]
                ),
                "supporting_evidence": (
                    attribution[
                        "supporting_evidence"
                    ]
                ),
                "limitations": attribution[
                    "limitations"
                ],
                "disclaimer": (
                    "Attribution confidence reflects the strength "
                    "of available attribution evidence. It does "
                    "not establish identity, legal ownership, "
                    "criminal control, or criminal activity."
                ),
            },

            "evidence_layers": {
                "OBSERVED BLOCKCHAIN FACT": (
                    "Facts directly supplied by canonical "
                    "transaction/graph evidence."
                ),
                "EXTERNAL INTELLIGENCE MATCH": (
                    "External intelligence supplied by the "
                    "Exchange Intelligence module."
                ),
                "ANALYTICAL INFERENCE": (
                    "Conclusions calculated from supplied "
                    "transaction, graph, behavioral, temporal, "
                    "and intelligence evidence."
                ),
            },

            # Explicitly prohibit UI merging.
            "do_not_merge_risk_and_attribution": True,
        }


