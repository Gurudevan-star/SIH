            "matched": True,
            "evidence": [
                {
                    "evidence_layer": (
                        "EXTERNAL INTELLIGENCE MATCH"
                    ),
                    "record_id": "intel-001",
                    "exchange": {
                        "exchange_id": "exchange_a",
                        "name": "Exchange A",
                    },
                    "address": "0xABC",
                    "chain": "ethereum",
                    "address_type": "HOT_WALLET",
                    "classification": "VERIFIED",
                    "source": "official_exchange",
                    "source_reference": "official-001",
                    "verified_at": "2026-01-01",
                    "confidence": 98,
                    "source_quality": 0.98,
                    "freshness_factor": 1.0,
                }
            ],
        },
        "evidence": [
            {
                "evidence_id": "intel",
                "evidence_type": "intelligence_evidence",
                "source_id": "intel",
                "description": "Exchange intelligence",
            }
        ],
    }

    result = service.assess(
        context
    )

    assert (
        result[
            "attribution_assessment"
        ][
