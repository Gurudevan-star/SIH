class WalletClusterRiskAdapter:
    """
    Lightweight adapter demonstrating how the Risk Engine can consume
    clustering results without needing to know clustering internals.
    """

    @staticmethod
    def to_risk_records(
        clustering_result: Mapping[str, Any],
    ) -> List[Dict[str, Any]]:
        records = []

        for cluster in clustering_result.get(
            "clusters",
            [],
        ):
            records.append(
                {
                    "cluster_id": cluster[
                        "cluster_id"
                    ],
                    "member_addresses": list(
                        cluster[
                            "member_addresses"
                        ]
                    ),
                    "behavioral_confidence": cluster[
                        "cluster_confidence"
                    ],
                    "evidence": cluster[
                        "similarity_evidence"
                    ],
                    "risk_semantics": (
                        "Behavioral similarity is an "
                        "analytical signal only."
                    ),
                }
            )

        return records


# ============================================================================
# Investigation Dashboard adapter
# ============================================================================

class WalletClusterDashboardAdapter:
    """
    Converts the clustering output into a dashboard-friendly structure.
    """

    @staticmethod
    def to_dashboard(
        clustering_result: Mapping[str, Any],
    ) -> Dict[str, Any]:

        return {
            "investigation_id": (
                clustering_result[
                    "investigation_id"
                ]
            ),
            "summary": {
                "cluster_count": (
                    clustering_result[
                        "cluster_count"
                    ]
                ),
                "wallet_count": len(
                    clustering_result[
                        "wallet_features"
                    ]
                ),
                "unclustered_count": len(
                    clustering_result[
                        "unclustered_addresses"
                    ]
                ),
            },
            "clusters": [
                {
                    "cluster_id": cluster[
                        "cluster_id"
                    ],
                    "members": cluster[
                        "member_addresses"
                    ],
                    "confidence": cluster[
                        "cluster_confidence"
                    ],
                    "confidence_label": (
                        WalletClusterDashboardAdapter
                        ._confidence_label(
                            cluster[
                                "cluster_confidence"
                            ]
                        )
                    ),
                    "evidence": cluster[
                        "similarity_evidence"
                    ],
                }
                for cluster in clustering_result[
                    "clusters"
                ]
            ],
        }

    @staticmethod
    def _confidence_label(
        confidence: float,
    ) -> str:
        if confidence >= 85:
            return "high behavioral similarity"

        if confidence >= 70:
            return "moderate behavioral similarity"

        return "low behavioral similarity"


