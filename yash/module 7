def _make_test_graph(
    transactions: List[Dict[str, Any]],
) -> nx.MultiDiGraph:

    graph = _transactions_to_graph(
        transactions
    )

    graph.graph[
        "investigation_id"
    ] = "TEST-INV"

    return graph


def test_isolated_wallets():
    """
    Wallets with no behavioral similarity should remain unclustered.
    """

    transactions = [
        {
            "transaction_hash": "a1",
            "from": "A",
            "to": "X",
            "value": 10,
            "timestamp": 100,
        },
        {
            "transaction_hash": "b1",
            "from": "B",
            "to": "Y",
            "value": 10000,
            "timestamp": 200,
        },
    ]

    service = WalletClusteringService(
        WalletClusteringConfig(
            similarity_threshold=0.95,
            min_matching_features=5,
        )
    )

    result = service.cluster(
        _make_test_graph(transactions),
        "TEST-INV",
    )

    assert result["cluster_count"] == 0
    assert set(
        result["unclustered_addresses"]
    ) == {"A", "B", "X", "Y"}


