"""
CryptoTrace Evidence and Provenance Engine
==========================================

Purpose
-------
Converts analytical outputs into immutable, traceable evidence records.

Evidence chain:

    Claim
      ↓
    Analytical reasoning
      ↓
    Evidence item
      ↓
    Transaction / Intelligence source
      ↓
    Blockchain reference

The engine does NOT invent evidence.

Synthetic/demo records must explicitly carry synthetic=True.

Dependencies:
    Python 3.10+
    No blockchain/API dependency
"""

from __future__ import annotations

from dataclasses import dataclass, field, asdict
from datetime import datetime, timezone
from enum import Enum
from hashlib import sha256
from typing import Any, Dict, Iterable, List, Optional, Sequence, Tuple
import copy
import json


# ============================================================================
# ENUMS
# ============================================================================

class EvidenceType(str, Enum):
    TRANSACTION = "TRANSACTION"
    GRAPH_PATH = "GRAPH_PATH"
    CLUSTER_FEATURE = "CLUSTER_FEATURE"
    EXCHANGE_INTELLIGENCE = "EXCHANGE_INTELLIGENCE"
    RISK_FACTOR = "RISK_FACTOR"
    ALERT = "ALERT"
    INVESTIGATION_EVENT = "INVESTIGATION_EVENT"


class EvidenceStatus(str, Enum):
    OBSERVED = "OBSERVED"
    INFERRED = "INFERRED"
    PROBABLE = "PROBABLE"
    VERIFIED = "VERIFIED"
    UNKNOWN = "UNKNOWN"


# ============================================================================
# HELPERS
# ============================================================================

def utc_now() -> str:
    return datetime.now(timezone.utc).isoformat()


def stable_json(value: Any) -> str:
    return json.dumps(
        value,
        sort_keys=True,
        separators=(",", ":"),
        default=str,
    )


def stable_id(prefix: str, payload: Any) -> str:
    digest = sha256(stable_json(payload).encode("utf-8")).hexdigest()[:24]
    return f"{prefix}_{digest}"


def clamp_score(value: float) -> float:
    return max(0.0, min(100.0, float(value)))


# ============================================================================
# CORE EVIDENCE MODEL
# ============================================================================

@dataclass(frozen=True)
class EvidenceRecord:
    """
    Immutable evidence item.

    The object itself cannot be modified after creation.

    Updates must create a new version through EvidenceService.version_evidence().
    """

    evidence_id: str
    case_id: str
    investigation_id: str

    type: EvidenceType
    status: EvidenceStatus

    description: str
    source_reference: str

    transaction_hash: Optional[str] = None
    block_number: Optional[int] = None
    timestamp: Optional[str] = None

    source_system: str = "cryptotrace"

    created_at: str = field(default_factory=utc_now)

    # Explicit demo/synthetic marker.
    synthetic: bool = False

    # Versioning.
    version: int = 1
    supersedes_evidence_id: Optional[str] = None

    # Optional structured metadata.
    metadata: Dict[str, Any] = field(default_factory=dict)


@dataclass(frozen=True)
class ProvenanceRelationship:
    """
    Directed provenance relationship.

    Example:

        risk-factor-123
             SUPPORTS
        graph-path-456
             DERIVED_FROM
        transaction-789
    """

    relationship_id: str

    investigation_id: str

    from_evidence_id: str
    to_evidence_id: str

    relationship_type: str

    description: str = ""

    created_at: str = field(default_factory=utc_now)


@dataclass(frozen=True)
class ClaimRecord:
    """
    A reportable analytical claim.

    Claims are not evidence themselves.

    They must point to evidence through provenance relationships.
    """

    claim_id: str
    case_id: str
    investigation_id: str

    statement: str
    status: EvidenceStatus

    evidence_ids: Tuple[str, ...]

    created_at: str = field(default_factory=utc_now)

    synthetic: bool = False


@dataclass(frozen=True)
class EvidenceVersion:
    evidence_id: str
    version: int
    supersedes_evidence_id: Optional[str]

    created_at: str
    snapshot: Dict[str, Any]


# ============================================================================
# IN-MEMORY EVIDENCE REPOSITORY
# ============================================================================

class EvidenceRepository:
    """
    Repository abstraction.

    Replace this with PostgreSQL, MongoDB, etc. without changing the
    EvidenceService.

    The repository deliberately does not provide update/delete operations
    for evidence records.
    """

    def __init__(self) -> None:
        self._evidence: Dict[str, EvidenceRecord] = {}
        self._relationships: Dict[str, ProvenanceRelationship] = {}
        self._claims: Dict[str, ClaimRecord] = {}
        self._versions: Dict[str, List[EvidenceVersion]] = {}

    # ------------------------------------------------------------------
    # Evidence
    # ------------------------------------------------------------------

    def add_evidence(self, evidence: EvidenceRecord) -> EvidenceRecord:
        if evidence.evidence_id in self._evidence:
            raise ValueError(
                f"Evidence already exists: {evidence.evidence_id}"
            )

        self._evidence[evidence.evidence_id] = evidence

        self._versions[evidence.evidence_id] = [
            EvidenceVersion(
                evidence_id=evidence.evidence_id,
                version=evidence.version,
                supersedes_evidence_id=evidence.supersedes_evidence_id,
                created_at=evidence.created_at,
                snapshot=copy.deepcopy(asdict(evidence)),
            )
        ]

        return evidence

    def get_evidence(self, evidence_id: str) -> EvidenceRecord:
        try:
            return self._evidence[evidence_id]
        except KeyError:
            raise KeyError(f"Unknown evidence: {evidence_id}")

    def all_evidence(self, investigation_id: Optional[str] = None) -> List[EvidenceRecord]:
        values = list(self._evidence.values())

        if investigation_id is not None:
            values = [
                item
                for item in values
                if item.investigation_id == investigation_id
            ]

        return sorted(
            values,
            key=lambda x: x.evidence_id,
        )

    # ------------------------------------------------------------------
    # Relationships
    # ------------------------------------------------------------------

    def add_relationship(
        self,
        relationship: ProvenanceRelationship,
    ) -> ProvenanceRelationship:

        if relationship.relationship_id in self._relationships:
            raise ValueError(
                f"Relationship already exists: "
                f"{relationship.relationship_id}"
            )

        if relationship.from_evidence_id not in self._evidence:
            raise ValueError(
                f"Unknown source evidence: "
                f"{relationship.from_evidence_id}"
            )

        if relationship.to_evidence_id not in self._evidence:
            raise ValueError(
                f"Unknown target evidence: "
                f"{relationship.to_evidence_id}"
            )

        self._relationships[
            relationship.relationship_id
        ] = relationship

        return relationship

    def all_relationships(
        self,
        investigation_id: Optional[str] = None,
    ) -> List[ProvenanceRelationship]:

        values = list(self._relationships.values())

        if investigation_id is not None:
            values = [
                item
                for item in values
                if item.investigation_id == investigation_id
            ]

        return sorted(
            values,
            key=lambda x: x.relationship_id,
        )

    # ------------------------------------------------------------------
    # Claims
    # ------------------------------------------------------------------

    def add_claim(self, claim: ClaimRecord) -> ClaimRecord:
        if claim.claim_id in self._claims:
            raise ValueError(
                f"Claim already exists: {claim.claim_id}"
            )

        for evidence_id in claim.evidence_ids:
            if evidence_id not in self._evidence:
                raise ValueError(
                    f"Claim references unknown evidence: {evidence_id}"
                )

        self._claims[claim.claim_id] = claim
        return claim

    def get_claim(self, claim_id: str) -> ClaimRecord:
        return self._claims[claim_id]

    def all_claims(
        self,
        investigation_id: Optional[str] = None,
    ) -> List[ClaimRecord]:

        values = list(self._claims.values())

        if investigation_id is not None:
            values = [
                item
                for item in values
                if item.investigation_id == investigation_id
            ]

        return sorted(
            values,
            key=lambda x: x.claim_id,
        )

    # ------------------------------------------------------------------
    # Version history
    # ------------------------------------------------------------------

    def versions(self, evidence_id: str) -> List[EvidenceVersion]:
        if evidence_id not in self._versions:
            raise KeyError(f"Unknown evidence: {evidence_id}")

        return list(self._versions[evidence_id])


# ============================================================================
# INVESTIGATION CONTEXT ADAPTER
# ============================================================================

@dataclass
class InvestigationContext:
    """
    Adapter object for analytical modules.

    All fields are optional because evidence must only be created when
    corresponding analytical evidence actually exists.
    """

    case_id: str
    investigation_id: str

    transactions: Sequence[Dict[str, Any]] = field(default_factory=list)

    graph_paths: Sequence[Dict[str, Any]] = field(default_factory=list)

    cluster_results: Sequence[Dict[str, Any]] = field(default_factory=list)

    risk_assessment: Optional[Dict[str, Any]] = None

    attribution_assessment: Optional[Dict[str, Any]] = None

    exchange_matches: Sequence[Dict[str, Any]] = field(
        default_factory=list
    )

    alerts: Sequence[Dict[str, Any]] = field(default_factory=list)

    investigation_events: Sequence[Dict[str, Any]] = field(
        default_factory=list
    )


# ============================================================================
# EVIDENCE SERVICE
# ============================================================================

class EvidenceService:
    """
    Main Evidence and Provenance Engine.

    Responsibilities:

    - convert existing analytical outputs into evidence
    - preserve source references
    - construct provenance relationships
    - build reportable claims
    - reject unsupported claims
    - provide immutable versioning
    """

    def __init__(
        self,
        repository: Optional[EvidenceRepository] = None,
    ) -> None:

        self.repository = repository or EvidenceRepository()

    # ==================================================================
    # PUBLIC API
    # ==================================================================

    def build_investigation_evidence(
        self,
        investigation_id: str,
        context: Optional[InvestigationContext] = None,
    ) -> Dict[str, Any]:

        if context is None:
            raise ValueError(
                "InvestigationContext is required. "
                "EvidenceService does not retrieve blockchain data."
            )

        if context.investigation_id != investigation_id:
            raise ValueError(
                "Investigation ID does not match the supplied context."
            )

        evidence_ids: List[str] = []
        relationship_ids: List[str] = []
        claim_ids: List[str] = []

        # --------------------------------------------------------------
        # 1. TRANSACTIONS
        # --------------------------------------------------------------

        transaction_evidence = {}

        for tx in sorted(
            context.transactions,
            key=lambda item: stable_json(item),
        ):

            evidence = self._transaction_evidence(
                context,
                tx,
            )

            if evidence is None:
                continue

            self.repository.add_evidence(evidence)

            evidence_ids.append(evidence.evidence_id)

            tx_hash = tx.get("transaction_hash") or tx.get("tx_hash")

            if tx_hash:
                transaction_evidence[tx_hash] = evidence.evidence_id

        # --------------------------------------------------------------
        # 2. GRAPH PATHS
        # --------------------------------------------------------------

        graph_evidence = {}

        for path in sorted(
            context.graph_paths,
            key=lambda item: stable_json(item),
        ):

            evidence = self._graph_path_evidence(
                context,
                path,
            )

            if evidence is None:
                continue

            self.repository.add_evidence(evidence)

            evidence_ids.append(evidence.evidence_id)

            # Connect graph path to underlying transaction evidence.
            path_tx_hashes = self._extract_transaction_hashes(path)

            for tx_hash in path_tx_hashes:

                tx_evidence_id = transaction_evidence.get(tx_hash)

                if not tx_evidence_id:
                    continue

                relationship = self._relationship(
                    context,
                    evidence.evidence_id,
                    tx_evidence_id,
                    "DERIVED_FROM",
                    f"Graph path derived from transaction {tx_hash}.",
                )

                self.repository.add_relationship(relationship)
                relationship_ids.append(
                    relationship.relationship_id
                )

            path_key = path.get("path_id") or evidence.evidence_id
            graph_evidence[path_key] = evidence.evidence_id

        # --------------------------------------------------------------
        # 3. BEHAVIORAL CLUSTERS
        # --------------------------------------------------------------

        cluster_evidence = {}

        for cluster in sorted(
            context.cluster_results,
            key=lambda item: stable_json(item),
        ):

            evidence = self._cluster_evidence(
                context,
                cluster,
            )

            if evidence is None:
                continue

            self.repository.add_evidence(evidence)

            evidence_ids.append(evidence.evidence_id)

            cluster_id = cluster.get("cluster_id")

            if cluster_id:
                cluster_evidence[cluster_id] = evidence.evidence_id

        # --------------------------------------------------------------
        # 4. EXCHANGE INTELLIGENCE
        # --------------------------------------------------------------

        intelligence_evidence = {}

        for match in sorted(
            context.exchange_matches,
            key=lambda item: stable_json(item),
        ):

            evidence = self._exchange_evidence(
                context,
                match,
            )

            if evidence is None:
                continue

            self.repository.add_evidence(evidence)

            evidence_ids.append(evidence.evidence_id)

            address = match.get("address")

            if address:
                intelligence_evidence[address] = evidence.evidence_id

        # --------------------------------------------------------------
        # 5. RISK FACTORS
        # --------------------------------------------------------------

        risk_evidence = []

        if context.risk_assessment:

            for factor in sorted(
                context.risk_assessment.get("factors", []),
                key=lambda item: stable_json(item),
            ):

                evidence = self._risk_factor_evidence(
                    context,
                    factor,
                )

                # IMPORTANT:
                # A factor with no evidence is not turned into evidence.
                if evidence is None:
                    continue

                self.repository.add_evidence(evidence)
                evidence_ids.append(evidence.evidence_id)
                risk_evidence.append(evidence)

                # Connect factor evidence to referenced evidence.
                for source_id in factor.get("evidence_ids", []):

                    if source_id not in {
                        item.evidence_id
                        for item in self.repository.all_evidence(
                            investigation_id
                        )
                    }:
                        continue

                    relationship = self._relationship(
                        context,
                        evidence.evidence_id,
                        source_id,
                        "SUPPORTED_BY",
                        "Risk factor supported by analytical evidence.",
                    )

                    self.repository.add_relationship(relationship)
                    relationship_ids.append(
                        relationship.relationship_id
                    )

        # --------------------------------------------------------------
        # 6. ALERTS
        # --------------------------------------------------------------

        for alert in sorted(
            context.alerts,
            key=lambda item: stable_json(item),
        ):

            evidence = self._alert_evidence(
                context,
                alert,
            )

            if evidence is None:
                continue

            self.repository.add_evidence(evidence)
            evidence_ids.append(evidence.evidence_id)

        # --------------------------------------------------------------
        # 7. INVESTIGATION EVENTS
        # --------------------------------------------------------------

        for event in sorted(
            context.investigation_events,
            key=lambda item: stable_json(item),
        ):

            evidence = self._investigation_event_evidence(
                context,
                event,
            )

            if evidence is None:
                continue

            self.repository.add_evidence(evidence)
            evidence_ids.append(evidence.evidence_id)

        # --------------------------------------------------------------
        # 8. REPORTABLE CLAIMS
        # --------------------------------------------------------------

        claims = self._build_supported_claims(
            context,
            transaction_evidence,
            intelligence_evidence,
            risk_evidence,
        )

        for claim in claims:

            self.repository.add_claim(claim)
            claim_ids.append(claim.claim_id)

            # Claim -> evidence provenance.
            for evidence_id in claim.evidence_ids:

                relationship = self._relationship(
                    context,
                    claim.claim_id,
                    evidence_id,
                    "SUPPORTED_BY",
                    "Claim is explicitly supported by evidence.",
                )

                # Claims are not stored as evidence, therefore the
                # repository relationship method expects evidence IDs.
                #
                # Instead create claim provenance separately.
                #
                # See _store_claim_relationship below.
                self._store_claim_relationship(
                    context,
                    claim.claim_id,
                    evidence_id,
                    "SUPPORTED_BY",
                    "Claim is explicitly supported by evidence.",
                )

        # --------------------------------------------------------------
        # FINAL RESULT
        # --------------------------------------------------------------

        return {
            "investigation_id": investigation_id,
            "evidence": [
                asdict(item)
                for item in self.repository.all_evidence(
                    investigation_id
                )
            ],
            "provenance_relationships": [
                asdict(item)
                for item in self.repository.all_relationships(
                    investigation_id
                )
            ],
            "claims": [
                asdict(item)
                for item in self.repository.all_claims(
                    investigation_id
                )
            ],
        }

    # ==================================================================
    # TRANSACTION EVIDENCE
    # ==================================================================

    def _transaction_evidence(
        self,
        context: InvestigationContext,
        tx: Dict[str, Any],
    ) -> Optional[EvidenceRecord]:

        tx_hash = tx.get("transaction_hash") or tx.get("tx_hash")

        if not tx_hash:
            return None

        evidence_id = stable_id(
            "ev_tx",
            {
                "investigation_id": context.investigation_id,
                "transaction_hash": tx_hash,
            },
        )

        return EvidenceRecord(
            evidence_id=evidence_id,
            case_id=context.case_id,
            investigation_id=context.investigation_id,
            type=EvidenceType.TRANSACTION,
            status=EvidenceStatus.OBSERVED,
            description=(
                f"Observed canonical transaction {tx_hash}."
            ),
            source_reference=(
                tx.get("source_reference")
                or f"transaction:{tx_hash}"
            ),
            transaction_hash=tx_hash,
            block_number=tx.get("block_number"),
            timestamp=tx.get("timestamp"),
            source_system=(
                tx.get("source_system")
                or "canonical_transaction_store"
            ),
            synthetic=bool(tx.get("synthetic", False)),
            metadata={
                "chain": tx.get("chain"),
                "from_address": tx.get("from_address"),
                "to_address": tx.get("to_address"),
                "asset": tx.get("asset"),
                "value": tx.get("value"),
            },
        )

    # ==================================================================
    # GRAPH PATH EVIDENCE
    # ==================================================================

    def _graph_path_evidence(
        self,
        context: InvestigationContext,
        path: Dict[str, Any],
    ) -> Optional[EvidenceRecord]:

        path_id = path.get("path_id")

        if not path_id:
            return None

        tx_hashes = self._extract_transaction_hashes(path)

        # A graph path without underlying transactions is unsupported.
        if not tx_hashes:
            return None

        evidence_id = stable_id(
            "ev_path",
            {
                "investigation_id": context.investigation_id,
                "path_id": path_id,
                "transaction_hashes": tx_hashes,
            },
        )

        return EvidenceRecord(
            evidence_id=evidence_id,
            case_id=context.case_id,
            investigation_id=context.investigation_id,
            type=EvidenceType.GRAPH_PATH,
            status=EvidenceStatus.INFERRED,
            description=(
                f"Analytical graph path {path_id} contains "
                f"{len(tx_hashes)} transaction edge(s)."
            ),
            source_reference=f"graph_path:{path_id}",
            source_system="cryptotrace_fund_tracing",
            synthetic=bool(path.get("synthetic", False)),
            metadata={
                "path_id": path_id,
                "nodes": path.get("nodes", []),
                "transaction_hashes": tx_hashes,
                "depth": path.get("depth"),
            },
        )

    # ==================================================================
    # CLUSTER EVIDENCE
    # ==================================================================

    def _cluster_evidence(
        self,
        context: InvestigationContext,
        cluster: Dict[str, Any],
    ) -> Optional[EvidenceRecord]:

        cluster_id = cluster.get("cluster_id")

        if not cluster_id:
            return None

        members = cluster.get("member_addresses", [])

        if not members:
            return None

        evidence_id = stable_id(
            "ev_cluster",
            {
                "investigation_id": context.investigation_id,
                "cluster_id": cluster_id,
                "members": sorted(members),
            },
        )

        confidence = clamp_score(
            cluster.get("cluster_confidence", 0)
        )

        return EvidenceRecord(
            evidence_id=evidence_id,
            case_id=context.case_id,
            investigation_id=context.investigation_id,
            type=EvidenceType.CLUSTER_FEATURE,
            status=EvidenceStatus.INFERRED,
            description=(
                f"Behavioral clustering identified {len(members)} "
                f"address(es) with similar observable transaction behavior. "
                f"Behavioral similarity confidence: {confidence:.2f}/100."
            ),
            source_reference=f"behavioral_cluster:{cluster_id}",
            source_system="cryptotrace_wallet_clustering",
            synthetic=bool(cluster.get("synthetic", False)),
            metadata={
                "cluster_id": cluster_id,
                "member_addresses": sorted(members),
                "features": cluster.get("features", {}),
                "similarity_evidence": cluster.get(
                    "similarity_evidence",
                    [],
                ),
                "cluster_confidence": confidence,
                "interpretation": (
                    "Behavioral similarity only; this does not establish "
                    "common ownership, control, identity, or criminality."
                ),
            },
        )

    # ==================================================================
    # EXCHANGE INTELLIGENCE
    # ==================================================================

    def _exchange_evidence(
        self,
        context: InvestigationContext,
        match: Dict[str, Any],
    ) -> Optional[EvidenceRecord]:

        address = match.get("address")
        chain = match.get("chain")
        exchange = match.get("exchange")

        if not address or not chain or not exchange:
            return None

        source = match.get("source")
        source_reference = match.get("source_reference")
        classification = match.get("classification")

        # Provenance is mandatory.
        if not source or not source_reference:
            return None

        if classification not in {
            "VERIFIED",
            "PROBABLE",
            "UNKNOWN",
        }:
            raise ValueError(
                f"Invalid intelligence classification: {classification}"
            )

        confidence = clamp_score(
            match.get("confidence", 0)
        )

        evidence_id = stable_id(
            "ev_intel",
            {
                "investigation_id": context.investigation_id,
                "chain": chain,
                "address": address,
                "address_type": match.get("address_type"),
                "source": source,
                "source_reference": source_reference,
                "verified_at": match.get("verified_at"),
            },
        )

        return EvidenceRecord(
            evidence_id=evidence_id,
            case_id=context.case_id,
            investigation_id=context.investigation_id,
            type=EvidenceType.EXCHANGE_INTELLIGENCE,
            status=(
                EvidenceStatus.VERIFIED
                if classification == "VERIFIED"
                else EvidenceStatus.PROBABLE
                if classification == "PROBABLE"
                else EvidenceStatus.UNKNOWN
            ),
            description=(
                f"External intelligence source '{source}' associates "
                f"{chain} address {address} with {exchange}."
            ),
            source_reference=source_reference,
            source_system="cryptotrace_exchange_intelligence",
            synthetic=bool(match.get("synthetic", False)),
            metadata={
                "exchange": exchange,
                "address": address,
                "chain": chain,
                "address_type": match.get("address_type"),
                "classification": classification,
                "source": source,
                "source_reference": source_reference,
                "confidence": confidence,
                "verified_at": match.get("verified_at"),
                "limitations": [
                    "External intelligence is distinct from blockchain facts.",
                    "An intelligence match is not proof of criminal activity.",
                    "Attribution confidence does not establish human identity.",
                ],
            },
        )

    # ==================================================================
    # RISK FACTOR EVIDENCE
    # ==================================================================

    def _risk_factor_evidence(
        self,
        context: InvestigationContext,
        factor: Dict[str, Any],
    ) -> Optional[EvidenceRecord]:

        name = factor.get("factor_name")

        if not name:
            return None

        evidence_ids = factor.get("evidence_ids", [])

        # CRITICAL:
        # A risk factor with no supporting evidence must not become evidence.
        if not evidence_ids:
            return None

        normalized_value = factor.get(
            "normalized_value"
        )

        contribution = factor.get(
            "contribution"
        )

        evidence_id = stable_id(
            "ev_risk",
            {
                "investigation_id": context.investigation_id,
                "factor_name": name,
                "evidence_ids": sorted(evidence_ids),
                "normalized_value": normalized_value,
                "contribution": contribution,
            },
        )

        return EvidenceRecord(
            evidence_id=evidence_id,
            case_id=context.case_id,
            investigation_id=context.investigation_id,
            type=EvidenceType.RISK_FACTOR,
            status=EvidenceStatus.INFERRED,
            description=(
                f"Risk scoring factor '{name}' contributed "
                f"{contribution if contribution is not None else 0} "
                f"to the configured analytical risk score."
            ),
            source_reference=f"risk_factor:{name}",
            source_system="cryptotrace_risk_engine",
            metadata={
                "factor_name": name,
                "normalized_value": normalized_value,
                "weight": factor.get("weight"),
                "contribution": contribution,
                "evidence_ids": list(evidence_ids),
                "explanation": factor.get("explanation"),
                "interpretation": (
                    "This is an analytical indicator warranting "
                    "investigator attention; it does not prove fraud."
                ),
            },
        )

    # ==================================================================
    # ALERT EVIDENCE
    # ==================================================================

    def _alert_evidence(
        self,
        context: InvestigationContext,
        alert: Dict[str, Any],
    ) -> Optional[EvidenceRecord]:

        alert_id = alert.get("alert_id")

        if not alert_id:
            return None

        evidence_ids = alert.get("evidence_ids", [])

        if not evidence_ids:
            return None

        evidence_id = stable_id(
            "ev_alert",
            {
                "investigation_id": context.investigation_id,
                "alert_id": alert_id,
                "evidence_ids": sorted(evidence_ids),
            },
        )

        return EvidenceRecord(
            evidence_id=evidence_id,
            case_id=context.case_id,
            investigation_id=context.investigation_id,
            type=EvidenceType.ALERT,
            status=EvidenceStatus.INFERRED,
            description=(
                alert.get("description")
                or f"Analytical alert {alert_id}."
            ),
            source_reference=f"alert:{alert_id}",
            source_system="cryptotrace_risk_engine",
            metadata={
                "alert_id": alert_id,
                "severity": alert.get("severity"),
                "evidence_ids": list(evidence_ids),
            },
        )

    # ==================================================================
    # INVESTIGATION EVENT
    # ==================================================================

    def _investigation_event_evidence(
        self,
        context: InvestigationContext,
        event: Dict[str, Any],
    ) -> Optional[EvidenceRecord]:

        event_id = event.get("event_id")

        if not event_id:
            return None

        evidence_id = stable_id(
            "ev_event",
            {
                "investigation_id": context.investigation_id,
                "event_id": event_id,
            },
        )

        return EvidenceRecord(
            evidence_id=evidence_id,
            case_id=context.case_id,
            investigation_id=context.investigation_id,
            type=EvidenceType.INVESTIGATION_EVENT,
            status=EvidenceStatus.OBSERVED,
            description=(
                event.get("description")
                or f"Investigation event {event_id}."
            ),
            source_reference=f"investigation_event:{event_id}",
            source_system=(
                event.get("source_system")
                or "cryptotrace_investigation"
            ),
            timestamp=event.get("timestamp"),
            synthetic=bool(event.get("synthetic", False)),
            metadata={
                "event_id": event_id,
                "event_type": event.get("event_type"),
                "actor": event.get("actor"),
            },
        )

    # ==================================================================
    # CLAIM GENERATION
    # ==================================================================

    def _build_supported_claims(
        self,
        context: InvestigationContext,
        transaction_evidence: Dict[str, str],
        intelligence_evidence: Dict[str, str],
        risk_evidence: List[EvidenceRecord],
    ) -> List[ClaimRecord]:

        claims: List[ClaimRecord] = []

        # --------------------------------------------------------------
        # Exchange attribution claim
        # --------------------------------------------------------------

        for match in context.exchange_matches:

            address = match.get("address")
            exchange = match.get("exchange")
            classification = match.get("classification")

            if not address or not exchange:
                continue

            intelligence_id = intelligence_evidence.get(address)

            if not intelligence_id:
                continue

            # Need a transaction involving the attributed address.
            related_tx_ids = []

            for tx in context.transactions:

                tx_hash = (
                    tx.get("transaction_hash")
                    or tx.get("tx_hash")
                )

                if not tx_hash:
                    continue

                if (
                    tx.get("to_address") == address
                    or tx.get("from_address") == address
                ):
                    tx_evidence_id = transaction_evidence.get(tx_hash)

                    if tx_evidence_id:
                        related_tx_ids.append(tx_evidence_id)

            if not related_tx_ids:
                # Do not create an unsupported attribution statement.
                continue

            confidence = clamp_score(
                match.get("confidence", 0)
            )

            statement = (
                f"Funds reached a "
                f"{classification.lower()} exchange-associated address."
            )

            claim_id = stable_id(
                "claim_exchange",
                {
                    "investigation_id": context.investigation_id,
                    "address": address,
                    "exchange": exchange,
                    "classification": classification,
                    "intelligence_evidence": intelligence_id,
                    "transaction_evidence": sorted(related_tx_ids),
                },
            )

            claims.append(
                ClaimRecord(
                    claim_id=claim_id,
                    case_id=context.case_id,
                    investigation_id=context.investigation_id,
                    statement=statement,
                    status=(
                        EvidenceStatus.VERIFIED
                        if classification == "VERIFIED"
                        else EvidenceStatus.PROBABLE
                        if classification == "PROBABLE"
                        else EvidenceStatus.UNKNOWN
                    ),
                    evidence_ids=tuple(
                        sorted(
                            related_tx_ids
                            + [intelligence_id]
                        )
                    ),
                    synthetic=bool(match.get("synthetic", False)),
                )
            )

        # --------------------------------------------------------------
        # Risk claims
        # --------------------------------------------------------------

        for evidence in risk_evidence:

            factor_name = evidence.metadata.get(
                "factor_name"
            )

            if not factor_name:
                continue

            supporting = tuple(
                evidence.metadata.get(
                    "evidence_ids",
                    [],
                )
            )

            if not supporting:
                continue

            claim_id = stable_id(
                "claim_risk",
                {
                    "investigation_id": context.investigation_id,
                    "factor": factor_name,
                    "evidence": sorted(
                        supporting
                    ),
                },
            )

            claims.append(
                ClaimRecord(
                    claim_id=claim_id,
                    case_id=context.case_id,
                    investigation_id=context.investigation_id,
                    statement=(
                        f"The configured risk model identified "
                        f"'{factor_name}' as an analytical indicator "
                        f"warranting investigator attention."
                    ),
                    status=EvidenceStatus.INFERRED,
                    evidence_ids=(
                        evidence.evidence_id,
                        *supporting,
                    ),
                    synthetic=evidence.synthetic,
                )
            )

        return sorted(
            claims,
            key=lambda item: item.claim_id,
        )

    # ==================================================================
    # PROVENANCE
    # ==================================================================

    def _relationship(
        self,
        context: InvestigationContext,
        from_evidence_id: str,
        to_evidence_id: str,
        relationship_type: str,
        description: str,
    ) -> ProvenanceRelationship:

        return ProvenanceRelationship(
            relationship_id=stable_id(
                "prov",
                {
                    "investigation_id": context.investigation_id,
                    "from": from_evidence_id,
                    "to": to_evidence_id,
                    "type": relationship_type,
                },
            ),
            investigation_id=context.investigation_id,
            from_evidence_id=from_evidence_id,
            to_evidence_id=to_evidence_id,
            relationship_type=relationship_type,
            description=description,
        )

    def _store_claim_relationship(
        self,
        context: InvestigationContext,
        claim_id: str,
        evidence_id: str,
        relationship_type: str,
        description: str,
    ) -> None:

        # Claims live in a separate namespace from evidence.
        #
        # Store them in a lightweight claim provenance collection.
        #
        # This keeps evidence immutable while allowing:
        #
        # Claim -> Evidence
        #
        # without pretending the claim itself is an EvidenceRecord.

        if not hasattr(self, "_claim_relationships"):
            self._claim_relationships = []

        relationship_id = stable_id(
            "claimprov",
            {
                "investigation_id": context.investigation_id,
                "claim": claim_id,
                "evidence": evidence_id,
                "type": relationship_type,
            },
        )

        item = {
            "relationship_id": relationship_id,
            "investigation_id": context.investigation_id,
            "from_claim_id": claim_id,
            "to_evidence_id": evidence_id,
            "relationship_type": relationship_type,
            "description": description,
            "created_at": utc_now(),
        }

        self._claim_relationships.append(item)

    # ==================================================================
    # EXTRACTION
    # ==================================================================

    @staticmethod
    def _extract_transaction_hashes(
        path: Dict[str, Any],
    ) -> List[str]:

        hashes = []

        for item in path.get("transactions", []):

            if isinstance(item, str):
                hashes.append(item)

            elif isinstance(item, dict):

                tx_hash = (
                    item.get("transaction_hash")
                    or item.get("tx_hash")
                )

                if tx_hash:
                    hashes.append(tx_hash)

        for item in path.get("edges", []):

            if isinstance(item, dict):

                tx_hash = (
                    item.get("transaction_hash")
                    or item.get("tx_hash")
                )

                if tx_hash:
                    hashes.append(tx_hash)

        return sorted(set(hashes))

    # ==================================================================
    # IMMUTABLE VERSIONING
    # ==================================================================

    def version_evidence(
        self,
        evidence_id: str,
        changes: Dict[str, Any],
    ) -> EvidenceRecord:

        """
        Explicitly versions an evidence record.

        The original evidence is NEVER modified.

        A new EvidenceRecord is created with:

            version = old.version + 1
            supersedes_evidence_id = old.evidence_id

        The new ID is deterministic from the old record + changes.
        """

        original = self.repository.get_evidence(
            evidence_id
        )

        if not changes:
            raise ValueError(
                "Versioning requires explicit changes."
            )

        data = asdict(original)

        # Do not permit identity or historical fields to be rewritten.
        protected = {
            "evidence_id",
            "created_at",
            "version",
            "supersedes_evidence_id",
        }

        for key in changes:
            if key in protected:
                raise ValueError(
                    f"Cannot directly modify immutable field: {key}"
                )

        data.update(copy.deepcopy(changes))

        new_version = original.version + 1

        data["version"] = new_version
        data["supersedes_evidence_id"] = original.evidence_id
        data["created_at"] = utc_now()

        data["evidence_id"] = stable_id(
            "ev_version",
            {
                "original": original.evidence_id,
                "version": new_version,
                "changes": changes,
            },
        )

        versioned = EvidenceRecord(
            **data
        )

        self.repository.add_evidence(
            versioned
        )

        return versioned

    # ==================================================================
    # TRACEABILITY API
    # ==================================================================

    def trace_evidence(
        self,
        evidence_id: str,
    ) -> Dict[str, Any]:

        evidence = self.repository.get_evidence(
            evidence_id
        )

        relationships = [
            relationship
            for relationship in self.repository.all_relationships()
            if (
                relationship.from_evidence_id == evidence_id
                or relationship.to_evidence_id == evidence_id
            )
        ]

        related = []

        for relationship in relationships:

            other_id = (
                relationship.to_evidence_id
                if relationship.from_evidence_id == evidence_id
                else relationship.from_evidence_id
            )

            related.append(
                {
                    "relationship": asdict(
                        relationship
                    ),
                    "evidence": asdict(
                        self.repository.get_evidence(
                            other_id
                        )
                    ),
                }
            )

        return {
            "evidence": asdict(evidence),
            "relationships": related,
        }

    def trace_claim(
        self,
        claim_id: str,
    ) -> Dict[str, Any]:

        claim = self.repository.get_claim(
            claim_id
        )

        evidence_chain = []

        for evidence_id in claim.evidence_ids:

            evidence_chain.append(
                self.trace_evidence(
                    evidence_id
                )
            )

        claim_provenance = [
            relationship
            for relationship in getattr(
                self,
                "_claim_relationships",
                [],
            )
            if relationship["from_claim_id"] == claim_id
        ]

        return {
            "claim": asdict(claim),
            "evidence_chain": evidence_chain,
            "claim_provenance": claim_provenance,
        }

    # ==================================================================
    # REPORTING / DASHBOARD OUTPUT
    # ==================================================================

    def evidence_view(
        self,
        investigation_id: str,
    ) -> Dict[str, Any]:

        evidence = self.repository.all_evidence(
            investigation_id
        )

        return {
            "investigation_id": investigation_id,

            "observed_blockchain_facts": [
                asdict(item)
                for item in evidence
                if item.status == EvidenceStatus.OBSERVED
                and item.type == EvidenceType.TRANSACTION
            ],

            "external_intelligence_matches": [
                asdict(item)
                for item in evidence
                if item.type == EvidenceType.EXCHANGE_INTELLIGENCE
            ],

            "analytical_inferences": [
                asdict(item)
                for item in evidence
                if item.status == EvidenceStatus.INFERRED
                or item.type in {
                    EvidenceType.GRAPH_PATH,
                    EvidenceType.CLUSTER_FEATURE,
                    EvidenceType.RISK_FACTOR,
                }
            ],

            "verified_evidence": [
                asdict(item)
                for item in evidence
                if item.status == EvidenceStatus.VERIFIED
            ],

            "probable_evidence": [
                asdict(item)
                for item in evidence
                if item.status == EvidenceStatus.PROBABLE
            ],
        }


# ============================================================================
# VALIDATION HELPERS
# ============================================================================

def validate_evidence_chain(
    service: EvidenceService,
    investigation_id: str,
) -> Dict[str, Any]:

    evidence = service.repository.all_evidence(
        investigation_id
    )

    evidence_ids = {
        item.evidence_id
        for item in evidence
    }

    relationships = service.repository.all_relationships(
        investigation_id
    )

    dangling_relationships = []

    for relationship in relationships:

        if relationship.from_evidence_id not in evidence_ids:
            dangling_relationships.append(
                relationship.relationship_id
            )

        if relationship.to_evidence_id not in evidence_ids:
            dangling_relationships.append(
                relationship.relationship_id
            )

    return {
        "valid": not dangling_relationships,
        "evidence_count": len(evidence),
        "relationship_count": len(relationships),
        "dangling_relationships": sorted(
            set(dangling_relationships)
        ),
    }


