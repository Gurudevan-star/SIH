                "verified_at": "2026-01-01T00:00:00Z",
            },
            {
                "exchange": "Exchange B",
                "address": "0xABC",
                "chain": "ethereum",
                "address_type": "HOT_WALLET",
                "classification": "PROBABLE",
                "source": "source-B",
                "source_reference": "B:456",
                "confidence": 65,
                "verified_at": "2026-02-01T00:00:00Z",
            },
        ],
    )

    result = service.build_investigation_evidence(
