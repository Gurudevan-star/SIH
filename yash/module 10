def test_conflicting_intelligence_is_preserved():
    service = EvidenceService()

    context = InvestigationContext(
        case_id="CASE-6",
        investigation_id="INV-6",
        exchange_matches=[
            {
                "exchange": "Exchange A",
                "address": "0xABC",
