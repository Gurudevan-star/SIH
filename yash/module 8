# ============================================================================

class EvidencePresentationAdapter:
    """
    Frontend-compatible representation that explicitly separates the
    three evidence layers.

    This prevents UI consumers from displaying an intelligence match
    as if it were a blockchain fact.
    """

    @staticmethod
    def observed_blockchain_fact(
        *,
        address: str,
        chain: str,
        transaction_count: int,
        inbound_volume: float,
        outbound_volume: float,
    ) -> Dict[str, Any]:

        return {
            "evidence_layer": (
                EvidenceLayer
                .OBSERVED_BLOCKCHAIN_FACT
                .value
            ),
            "address": address,
            "chain": chain,
            "facts": {
                "transaction_count": (
                    transaction_count
                ),
                "inbound_volume": (
                    inbound_volume
                ),
                "outbound_volume": (
                    outbound_volume
                ),
            },
        }

    @staticmethod
    def external_intelligence_match(
        match_result: Mapping[str, Any],
    ) -> Dict[str, Any]:

        return {
            "evidence_layer": (
                EvidenceLayer
                .EXTERNAL_INTELLIGENCE_MATCH
                .value
            ),
            "matched": match_result[
                "matched"
            ],
            "exchange": match_result[
                "exchange"
            ],
            "address": match_result[
                "address"
            ],
            "chain": match_result[
                "chain"
            ],
            "address_type": match_result[
                "address_type"
            ],
            "classification": match_result[
                "classification"
            ],
            "source": match_result[
                "source"
            ],
            "source_reference": match_result[
                "source_reference"
            ],
            "confidence": match_result[
                "confidence"
            ],
            "verified_at": match_result[
                "verified_at"
            ],
            "label": (
                "External intelligence match"
            ),
            "warning": (
                "This is external intelligence, "
                "not an observed blockchain fact."
            ),
        }

    @staticmethod
    def analytical_inference(
        *,
        statement: str,
        confidence: float,
        supporting_evidence: List[
            Dict[str, Any]
        ],
    ) -> Dict[str, Any]:

        confidence = max(
            0.0,
            min(
                100.0,
                float(confidence),
            ),
        )

        return {
            "evidence_layer": (
                EvidenceLayer
                .ANALYTICAL_INFERENCE
                .value
            ),
            "statement": statement,
            "confidence": round(
                confidence,
                2,
            ),
            "supporting_evidence": (
                supporting_evidence
            ),
            "label": (
                "Analytical inference"
            ),
            "warning": (
                "This is an analytical inference and "
                "must not be represented as a direct "
                "blockchain fact."
            ),
        }


