                "Curated external intelligence; "
                "not proof of ownership, identity, "
                "control, or criminal activity."
            ),
        }

    # ------------------------------------------------------------------
    # Conflict handling
    # ------------------------------------------------------------------

    def _find_conflicts(
        self,
        records: Sequence[
            ExchangeIntelligenceRecord
        ],
    ) -> List[Dict[str, Any]]:

        conflicts = []

        for index, record_a in enumerate(
            records
        ):
            for record_b in records[
                index + 1:
            ]:

                # Conflict when independently sourced records disagree
                # on exchange or classification/address type.
                if (
                    record_a.provenance.source
                    == record_b.provenance.source
                    and record_a.provenance.source_reference
                    == record_b.provenance.source_reference
                ):
                    continue

                if (
                    record_a.exchange_id
                    != record_b.exchange_id
                    or record_a.classification
                    != record_b.classification
                    or record_a.address_type
                    != record_b.address_type
                ):
                    conflicts.append(
                        {
                            "record_a": (
                                self._record_summary(
                                    record_a
                                )
                            ),
                            "record_b": (
                                self._record_summary(
                                    record_b
                                )
                            ),
                            "resolution": (
                                "Preserved as conflicting "
                                "external intelligence; "
                                "primary result selected "
                                "deterministically by "
                                "confidence and evidence "
                                "ranking."
                            ),
                        }
                    )

        return conflicts

    @staticmethod
    def _record_summary(
        record: ExchangeIntelligenceRecord,
    ) -> Dict[str, Any]:

        return {
            "record_id": record.record_id,
            "exchange_id": record.exchange_id,
            "address": record.address,
            "chain": record.chain,
            "address_type": (
                record.address_type.value
            ),
            "classification": (
                record.classification.value
            ),
            "source": (
                record.provenance.source
            ),
            "source_reference": (
                record.provenance.source_reference
            ),
            "verified_at": (
                record.provenance.verified_at
            ),
            "confidence": record.confidence,
        }

    # ------------------------------------------------------------------
    # Confidence calculation
    # ------------------------------------------------------------------

    def calculate_intelligence_confidence(
        self,
        *,
        source: str,
        classification: str,
        verified_at: str,
    ) -> float:
        """
        Public confidence calculation.

        Formula:

            source_quality
                × classification_factor
                × freshness_factor
                × 100

        This is confidence in the intelligence evidence, not confidence
        in human/legal ownership.
        """

        classification_enum = (
            self._parse_classification(
                classification
            )
        )

        verified_at = self._validate_date(
            verified_at,
            "verified_at",
        )

        confidence = (
            self.source_registry.quality(
                source
            )
            * self._classification_factor(
                classification_enum
            )
            * self._freshness_factor(
                verified_at
            )
            * 100.0
        )

        return round(
            max(
                0.0,
                min(
                    100.0,
                    confidence,
                ),
            ),
            2,
        )

    @staticmethod
    def _classification_factor(
        classification: Classification,
    ) -> float:

        return {
            Classification.VERIFIED: 1.00,
            Classification.PROBABLE: 0.75,
            Classification.UNKNOWN: 0.25,
        }[classification]

    @staticmethod
    def _classification_rank(
        classification: str,
    ) -> int:

        return {
            Classification.VERIFIED.value: 0,
            Classification.PROBABLE.value: 1,
            Classification.UNKNOWN.value: 2,
        }.get(
            classification,
            3,
        )

    @staticmethod
    def _freshness_factor(
        verified_at: str,
    ) -> float:
        """
        Freshness penalty.

        This deliberately does not delete old intelligence.

        Age:
            <= 365 days: 1.00
            <= 730 days: 0.90
            <= 1095 days: 0.75
            > 1095 days: 0.60

        The original verification date remains intact and visible.
        """

        try:
            verified = (
                datetime.fromisoformat(
                    verified_at.replace(
                        "Z",
                        "+00:00",
                    )
                )
            )

            if verified.tzinfo is None:
                verified = verified.replace(
                    tzinfo=timezone.utc
                )

            now = datetime.now(
                timezone.utc
            )

            age_days = max(
                0,
                (
                    now - verified
                ).days,
            )

        except (
            TypeError,
            ValueError,
        ):
            return 0.50

        if age_days <= 365:
            return 1.00

        if age_days <= 730:
            return 0.90

        if age_days <= 1095:
            return 0.75

        return 0.60

    # ------------------------------------------------------------------
    # Validation
    # ------------------------------------------------------------------

    @staticmethod
    def _parse_classification(
        value: str,
    ) -> Classification:

        try:
            return Classification(
                str(value)
                .strip()
                .upper()
            )
        except ValueError:
            raise InvalidIntelligenceRecordError(
                f"Invalid classification: {value}"
            )

    @staticmethod
    def _parse_address_type(
        value: str,
    ) -> AddressType:

        try:
            return AddressType(
                str(value)
                .strip()
                .upper()
            )
        except ValueError:
            raise InvalidIntelligenceRecordError(
                f"Invalid address_type: {value}"
            )

    @staticmethod
    def _validate_date(
        value: str,
        field_name: str,
        allow_datetime: bool = False,
    ) -> str:

        value = str(value).strip()

        if not value:
            raise InvalidIntelligenceRecordError(
                f"{field_name} is required"
            )

        try:
            parsed = datetime.fromisoformat(
                value.replace(
                    "Z",
                    "+00:00",
                )
            )

            if (
                parsed.tzinfo is None
                and allow_datetime
            ):
                parsed = parsed.replace(
                    tzinfo=timezone.utc
                )

        except ValueError:
            raise InvalidIntelligenceRecordError(
                f"Invalid {field_name}: {value}"
            )

        return value

    @staticmethod
    def _utc_now() -> str:
        return (
            datetime.now(
                timezone.utc
            )
            .isoformat()
        )

    @staticmethod
    def _normalize(
        value: str,
    ) -> str:
        return str(value).strip().lower()

    # ------------------------------------------------------------------
    # Stable record ID
    # ------------------------------------------------------------------

    @staticmethod
    def _record_id(
        *,
        exchange_id: str,
        address: str,
        chain: str,
        address_type: str,
        classification: str,
        source: str,
        source_reference: str,
        verified_at: str,
    ) -> str:

        """
        Record identity includes the required matching dimensions:

            chain
            address
            address_type
            source
            verification date

        Additional fields are included to prevent two distinct curated
        claims from being silently collapsed.
        """

        identity = "|".join(
            [
                exchange_id.strip().lower(),
                chain.strip().lower(),
                address.strip().lower(),
                address_type.strip().upper(),
                source.strip().lower(),
                source_reference.strip(),
                verified_at.strip(),
                classification.strip().upper(),
            ]
        )

        digest = hashlib.sha256(
            identity.encode("utf-8")
        ).hexdigest()

        return f"intel-{digest[:24]}"

    # ------------------------------------------------------------------
    # Default source registry
    # ------------------------------------------------------------------

    @staticmethod
    def _default_source_registry(
    ) -> IntelligenceSourceRegistry:

        return IntelligenceSourceRegistry(
            [
                SourceQuality(
                    source="official_exchange",
                    quality_score=0.98,
                    description=(
                        "Official exchange-published address information."
                    ),
                ),
                SourceQuality(
                    source="regulator",
                    quality_score=0.98,
                    description=(
                        "Regulatory/public authority source."
                    ),
                ),
                SourceQuality(
                    source="curated_seed",
                    quality_score=0.90,
                    description=(
                        "Manually reviewed curated intelligence dataset."
                    ),
                ),
                SourceQuality(
                    source="public_dataset",
                    quality_score=0.80,
                    description=(
                        "Publicly available third-party dataset."
                    ),
                ),
                SourceQuality(
                    source="analyst",
                    quality_score=0.75,
                    description=(
                        "Internal analyst-curated intelligence."
                    ),
                ),
            ]
        )


