"""
CryptoTrace Exchange Intelligence Module
=========================================

Purpose
-------
Maintain curated external intelligence about exchange-associated blockchain
addresses while strictly separating that intelligence from observed
blockchain facts.

The module NEVER infers exchange ownership merely from transaction behavior.

Classification:
    VERIFIED
    PROBABLE
    UNKNOWN

Address types:
    DEPOSIT_ADDRESS
    HOT_WALLET
    COLD_WALLET
    WITHDRAWAL_ADDRESS
    CONTRACT
    UNKNOWN

Important semantics
-------------------
OBSERVED BLOCKCHAIN FACT
    A fact directly observed in canonical blockchain transaction data.

EXTERNAL INTELLIGENCE MATCH
    A curated external intelligence record exactly matching:
        chain + address + address_type + source
    with source provenance and verification date.

ANALYTICAL INFERENCE
    A downstream analytical conclusion derived by another engine.

This module itself only produces EXTERNAL INTELLIGENCE MATCH results.
It does not claim:
    - human ownership
    - legal ownership
    - identity
    - criminal control
    - criminal activity

Dependencies:
    Python standard library only.

Example:
    service = ExchangeIntelligenceService()

    service.register_exchange(
        exchange_id="binance",
        name="Binance",
    )

    service.add_intelligence_record(
        exchange_id="binance",
        address="0x123",
        chain="ethereum",
        address_type="HOT_WALLET",
        classification="VERIFIED",
        source="curated_seed",
        source_reference="seed-001",
        verified_at="2026-01-15",
    )

    result = service.match_address(
        address="0x123",
        chain="ethereum",
    )
"""

from __future__ import annotations

import csv
import hashlib
import json
from dataclasses import dataclass, asdict
from datetime import datetime, timezone
from enum import Enum
from io import StringIO
from typing import Any, Dict, Iterable, List, Mapping, Optional, Sequence, Tuple


# ============================================================================
# ENUMS
# ============================================================================

class Classification(str, Enum):
    VERIFIED = "VERIFIED"
    PROBABLE = "PROBABLE"
    UNKNOWN = "UNKNOWN"


class AddressType(str, Enum):
    DEPOSIT_ADDRESS = "DEPOSIT_ADDRESS"
    HOT_WALLET = "HOT_WALLET"
    COLD_WALLET = "COLD_WALLET"
    WITHDRAWAL_ADDRESS = "WITHDRAWAL_ADDRESS"
    CONTRACT = "CONTRACT"
    UNKNOWN = "UNKNOWN"


class EvidenceLayer(str, Enum):
    OBSERVED_BLOCKCHAIN_FACT = "OBSERVED BLOCKCHAIN FACT"
    EXTERNAL_INTELLIGENCE_MATCH = "EXTERNAL INTELLIGENCE MATCH"
    ANALYTICAL_INFERENCE = "ANALYTICAL INFERENCE"


# ============================================================================
# EXCEPTIONS
# ============================================================================

class ExchangeIntelligenceError(Exception):
    """Base exception for the intelligence module."""


class DuplicateIntelligenceRecordError(
    ExchangeIntelligenceError
):
    """Raised when an identical intelligence record already exists."""


class InvalidIntelligenceRecordError(
    ExchangeIntelligenceError
):
    """Raised when an intelligence record is invalid."""


class ConflictingIntelligenceRecordError(
    ExchangeIntelligenceError
):
    """
    Raised when records create an unresolved conflict for the same
    exact address/type/source identity.
    """


class ExchangeNotFoundError(
    ExchangeIntelligenceError
):
    """Raised when an exchange does not exist."""


# ============================================================================
# SOURCE QUALITY
# ============================================================================

@dataclass(frozen=True)
class SourceQuality:
    """
    Defines how much confidence the system gives to an intelligence source.

    quality_score:
        0.0 - 1.0

    The score is about source reliability, not ownership certainty.
    """

    source: str
    quality_score: float
    description: str = ""


class IntelligenceSourceRegistry:
    """
    Abstract source-quality registry.

    A commercial/public provider can replace this implementation later
    without changing ExchangeIntelligenceService.
    """

    DEFAULT_QUALITY = 0.50

    def __init__(
        self,
        sources: Optional[
            Iterable[SourceQuality]
        ] = None,
    ):
        self._sources: Dict[
            str,
            SourceQuality,
        ] = {}

        for source in sources or []:
            self.register(
                source.source,
                source.quality_score,
                source.description,
            )

    def register(
        self,
        source: str,
        quality_score: float,
        description: str = "",
    ) -> None:

        source = self._normalize_source(source)

        if not source:
            raise ValueError(
                "source must not be empty"
            )

        quality_score = float(
            quality_score
        )

        if not 0.0 <= quality_score <= 1.0:
            raise ValueError(
                "quality_score must be between 0 and 1"
            )

        self._sources[source] = SourceQuality(
            source=source,
            quality_score=quality_score,
            description=description,
        )

    def quality(
        self,
        source: str,
    ) -> float:

        source = self._normalize_source(
            source
        )

        record = self._sources.get(
            source
        )

        if record is None:
            return self.DEFAULT_QUALITY

        return record.quality_score

    @staticmethod
    def _normalize_source(
        source: str,
    ) -> str:
        return str(source).strip().lower()


