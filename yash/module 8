# ============================================================================
# PROVIDER ABSTRACTION
# ============================================================================

class IntelligenceProvider:
    """
    Abstract provider interface.

    Future providers can implement this interface:

        - commercial blockchain intelligence provider
        - public exchange-address dataset
        - internal analyst-curated dataset
        - regulator/public source

    The service does not depend on a specific provider.
    """

    provider_name = "abstract"

    def records(
        self,
    ) -> Iterable[
        ExchangeIntelligenceRecord
    ]:
        raise NotImplementedError


class CuratedDatasetProvider(
    IntelligenceProvider
):
    """
    Seed dataset provider.

    Can be initialized from Python records and can also be populated
    through CSV/JSON import helpers in the service.
    """

    provider_name = "curated"

    def __init__(
        self,
        records: Optional[
            Iterable[
                ExchangeIntelligenceRecord
            ]
        ] = None,
    ):
        self._records = list(
            records or []
        )

    def records(
        self,
    ) -> Iterable[
        ExchangeIntelligenceRecord
    ]:
        return list(self._records)

    def add(
        self,
        record: ExchangeIntelligenceRecord,
    ) -> None:
        self._records.append(record)


# ============================================================================
# STORAGE
# ============================================================================

class ExchangeIntelligenceRepository:
    """
    In-memory repository.

    Replaceable by PostgreSQL, SQLite, document storage, etc.

    The repository stores intelligence records only.
    It does not store or modify raw blockchain transactions.
    """

    def __init__(self):
        self._exchanges: Dict[
            str,
            ExchangeEntity,
        ] = {}

        self._records: Dict[
            str,
            ExchangeIntelligenceRecord,
        ] = {}

        # Exact lookup index:
        #
        # chain + address
        #
        # Multiple intelligence records may exist for the same address
        # because different sources may disagree.
        self._address_index: Dict[
            Tuple[str, str],
            List[str],
        ] = {}

    # ------------------------------------------------------------------
    # Exchanges
    # ------------------------------------------------------------------

    def add_exchange(
        self,
        exchange: ExchangeEntity,
    ) -> None:

        exchange_id = self._normalize(
            exchange.exchange_id
        )

        if not exchange_id:
            raise ValueError(
                "exchange_id must not be empty"
            )

        self._exchanges[
            exchange_id
        ] = exchange

    def get_exchange(
        self,
        exchange_id: str,
    ) -> Optional[ExchangeEntity]:

        return self._exchanges.get(
            self._normalize(exchange_id)
        )

    # ------------------------------------------------------------------
    # Intelligence records
    # ------------------------------------------------------------------

    def add_record(
        self,
        record: ExchangeIntelligenceRecord,
    ) -> None:

        if record.exchange_id not in self._exchanges:
            raise ExchangeNotFoundError(
                f"Unknown exchange: {record.exchange_id}"
            )

        if record.record_id in self._records:
            raise DuplicateIntelligenceRecordError(
                f"Duplicate intelligence record: "
                f"{record.record_id}"
            )

        self._records[
            record.record_id
        ] = record

        lookup_key = (
            self._normalize(record.chain),
            self._normalize_address(
                record.address
            ),
        )

        self._address_index.setdefault(
            lookup_key,
            [],
        ).append(
            record.record_id
        )

        # Deterministic ordering.
        self._address_index[
            lookup_key
        ].sort()

    def records_for_address(
        self,
        address: str,
        chain: str,
    ) -> List[
        ExchangeIntelligenceRecord
    ]:

        key = (
            self._normalize(chain),
            self._normalize_address(address),
        )

        record_ids = self._address_index.get(
            key,
            [],
        )

        return [
            self._records[record_id]
            for record_id in sorted(record_ids)
        ]

    def all_records(
        self,
    ) -> List[
        ExchangeIntelligenceRecord
    ]:
        return [
            self._records[key]
            for key in sorted(self._records)
        ]

    @staticmethod
    def _normalize(value: str) -> str:
        return str(value).strip().lower()

    @staticmethod
    def _normalize_address(
        address: str,
    ) -> str:
        """
        Address normalization is deliberately conservative.

        We strip surrounding whitespace and normalize case for matching.

        No checksum conversion or chain-specific transformation is
        performed here because address formats differ between networks.
        """
        return str(address).strip().lower()


# ============================================================================
# SERVICE
# ============================================================================

class ExchangeIntelligenceService:
    """
    Main Exchange Intelligence service.

    Public API:

        match_address(address, chain)

        register_exchange(...)

        add_intelligence_record(...)

        import_csv(...)

        import_json(...)

    Core rule:

        An address is classified as an exchange-associated address only
        when it has an exact curated intelligence record.

    Transaction volume, transaction count, counterparties, etc. are NOT
    used to infer exchange ownership.
    """

    ALGORITHM_VERSION = (
        "cryptotrace-exchange-intelligence-v1"
    )

    def __init__(
        self,
        repository: Optional[
            ExchangeIntelligenceRepository
        ] = None,
        source_registry: Optional[
            IntelligenceSourceRegistry
        ] = None,
        provider: Optional[
            IntelligenceProvider
        ] = None,
    ):

        self.repository = (
            repository
            or ExchangeIntelligenceRepository()
        )

        self.source_registry = (
            source_registry
            or self._default_source_registry()
        )

        self.provider = (
            provider
            or CuratedDatasetProvider()
        )

        # Load provider seed records.
        for record in self.provider.records():
            self.repository.add_record(
                record
            )

    # ------------------------------------------------------------------
    # Exchange management
    # ------------------------------------------------------------------

    def register_exchange(
        self,
        exchange_id: str,
        name: str,
        jurisdiction: Optional[str] = None,
        metadata: Optional[
            Dict[str, Any]
        ] = None,
    ) -> ExchangeEntity:

        exchange_id = (
            self._normalize(exchange_id)
        )

        exchange = ExchangeEntity(
            exchange_id=exchange_id,
            name=str(name).strip(),
            jurisdiction=jurisdiction,
            metadata=(
                dict(metadata)
                if metadata
                else None
            ),
        )

        self.repository.add_exchange(
            exchange
        )

        return exchange

    def get_exchange(
        self,
        exchange_id: str,
    ) -> Optional[ExchangeEntity]:

        return self.repository.get_exchange(
            exchange_id
        )

    # ------------------------------------------------------------------
    # Source management
    # ------------------------------------------------------------------

    def register_source(
        self,
        source: str,
        quality_score: float,
        description: str = "",
    ) -> None:

        self.source_registry.register(
            source=source,
            quality_score=quality_score,
            description=description,
        )

    # ------------------------------------------------------------------
    # Add intelligence
    # ------------------------------------------------------------------

    def add_intelligence_record(
        self,
        *,
        exchange_id: str,
        address: str,
        chain: str,
        address_type: str,
        classification: str,
        source: str,
        source_reference: str,
        verified_at: str,
        notes: Optional[str] = None,
        provider_type: str = "CURATED",
        imported_at: Optional[str] = None,
        confidence: Optional[float] = None,
    ) -> ExchangeIntelligenceRecord:

        exchange_id = self._normalize(
            exchange_id
        )

        address = str(address).strip()

        chain = self._normalize(
            chain
        )

        address_type_enum = (
            self._parse_address_type(
                address_type
            )
        )

        classification_enum = (
            self._parse_classification(
                classification
            )
        )

        source = self._normalize(
            source
        )

        source_reference = str(
            source_reference
        ).strip()

        verified_at = self._validate_date(
            verified_at,
            "verified_at",
        )

        imported_at = (
            imported_at
            or self._utc_now()
        )

        imported_at = self._validate_date(
            imported_at,
            "imported_at",
            allow_datetime=True,
        )

        if not address:
            raise InvalidIntelligenceRecordError(
                "address must not be empty"
            )

        if not chain:
            raise InvalidIntelligenceRecordError(
                "chain must not be empty"
            )

        if not source:
            raise InvalidIntelligenceRecordError(
                "source must not be empty"
            )

        if not source_reference:
            raise InvalidIntelligenceRecordError(
                "source_reference is required"
            )

        if not self.repository.get_exchange(
            exchange_id
        ):
            raise ExchangeNotFoundError(
                f"Unknown exchange: {exchange_id}"
            )

        # Calculate confidence from source quality unless explicitly
        # supplied. Even an explicit confidence is bounded.
        source_quality = (
            self.source_registry.quality(
                source
            )
        )

        calculated_confidence = (
            source_quality
            * self._classification_factor(
                classification_enum
            )
            * self._freshness_factor(
                verified_at
            )
            * 100.0
        )

        if confidence is None:
            final_confidence = (
                calculated_confidence
            )
        else:
            final_confidence = float(
                confidence
            )

            if not (
                0.0
                <= final_confidence
                <= 100.0
            ):
                raise InvalidIntelligenceRecordError(
                    "confidence must be between 0 and 100"
                )

        final_confidence = round(
            max(
                0.0,
                min(
                    100.0,
                    final_confidence,
                ),
            ),
            2,
        )

        record_id = (
            self._record_id(
                exchange_id=exchange_id,
                address=address,
                chain=chain,
                address_type=address_type_enum.value,
                classification=classification_enum.value,
                source=source,
                source_reference=source_reference,
                verified_at=verified_at,
            )
        )

        provenance = (
            IntelligenceProvenance(
                source=source,
                source_reference=source_reference,
                verified_at=verified_at,
                imported_at=imported_at,
                provider_type=provider_type,
                notes=notes,
            )
        )

        record = ExchangeIntelligenceRecord(
            exchange_id=exchange_id,
            address=address,
            chain=chain,
            address_type=address_type_enum,
            classification=classification_enum,
            provenance=provenance,
            confidence=final_confidence,
            record_id=record_id,
        )

        self.repository.add_record(
            record
        )

        return record

    # ------------------------------------------------------------------
    # Exact address matching
    # ------------------------------------------------------------------

    def match_address(
        self,
        address: str,
        chain: str,
    ) -> Dict[str, Any]:

        address = str(address).strip()

        chain = self._normalize(
            chain
        )

        records = (
            self.repository.records_for_address(
                address,
                chain,
            )
        )

        if not records:
            return {
                "matched": False,
                "exchange": None,
                "address": address,
                "chain": chain,
                "address_type": (
                    AddressType.UNKNOWN.value
                ),
                "classification": (
                    Classification.UNKNOWN.value
                ),
                "source": None,
                "source_reference": None,
                "confidence": 0.0,
                "verified_at": None,
                "evidence_layer": (
                    EvidenceLayer
                    .EXTERNAL_INTELLIGENCE_MATCH
                    .value
                ),
                "evidence": [],
                "conflicts": [],
            }

        # Group by address type and source.
        #
        # Multiple sources are allowed and are explicitly preserved.
        #
        # Never silently merge contradictory intelligence.
        grouped: Dict[
            Tuple[str, str],
            List[ExchangeIntelligenceRecord],
        ] = {}

        for record in records:
            key = (
                record.address_type.value,
                record.provenance.source,
            )

            grouped.setdefault(
                key,
                [],
            ).append(record)

        evidence = []

        for key in sorted(grouped):
            group = sorted(
                grouped[key],
                key=lambda record: (
                    record.provenance.verified_at,
                    record.record_id,
                ),
                reverse=True,
            )

            selected = group[0]

            exchange = (
                self.repository.get_exchange(
                    selected.exchange_id
                )
            )

            if exchange is None:
                continue

            evidence.append(
                self._record_to_evidence(
                    selected,
                    exchange,
                )
            )

        # Determine primary result deterministically.
        #
        # Ranking:
        #   1. confidence
        #   2. classification
        #   3. verification date
        #   4. source
        #   5. exchange ID
        #
        # Conflicts remain visible in "conflicts".
        ranked = sorted(
            evidence,
            key=lambda item: (
                -float(
                    item["confidence"]
                ),
                self._classification_rank(
                    item["classification"]
                ),
                item["verified_at"] or "",
                item["source"] or "",
                item["exchange"]["exchange_id"],
            ),
        )

        primary = ranked[0]

        conflicts = self._find_conflicts(
            records
        )

        return {
            "matched": True,
            "exchange": primary[
                "exchange"
            ],
            "address": address,
            "chain": chain,
            "address_type": primary[
                "address_type"
            ],
            "classification": primary[
                "classification"
            ],
            "source": primary[
                "source"
            ],
            "source_reference": primary[
                "source_reference"
            ],
            "confidence": primary[
                "confidence"
            ],
            "verified_at": primary[
                "verified_at"
            ],
            "evidence_layer": (
                EvidenceLayer
                .EXTERNAL_INTELLIGENCE_MATCH
                .value
            ),
            "evidence": ranked,
            "conflicts": conflicts,
            "has_conflicting_intelligence": bool(
                conflicts
            ),
        }

    # ------------------------------------------------------------------
    # CSV import
    # ------------------------------------------------------------------

    def import_csv(
        self,
        csv_data: str,
        *,
        provider_type: str = "CURATED",
    ) -> Dict[str, Any]:
        """
        Import CSV intelligence records.

        Required columns:

            exchange_id
            address
            chain
            address_type
            classification
            source
            source_reference
            verified_at

        Optional:

            notes
            imported_at
            confidence
        """

        reader = csv.DictReader(
            StringIO(csv_data)
        )

        imported = []
        duplicates = []
        rejected = []

        for row_number, row in enumerate(
            reader,
            start=2,
        ):
            try:
                record = (
                    self.add_intelligence_record(
                        exchange_id=row[
                            "exchange_id"
                        ],
                        address=row[
                            "address"
                        ],
                        chain=row[
                            "chain"
                        ],
                        address_type=row[
                            "address_type"
                        ],
                        classification=row[
                            "classification"
                        ],
                        source=row[
                            "source"
                        ],
                        source_reference=row[
                            "source_reference"
                        ],
                        verified_at=row[
                            "verified_at"
                        ],
                        notes=row.get(
                            "notes"
                        ),
                        provider_type=provider_type,
                        imported_at=row.get(
                            "imported_at"
                        ) or None,
                        confidence=(
                            float(
                                row[
                                    "confidence"
                                ]
                            )
                            if row.get(
                                "confidence"
                            )
                            not in (
                                None,
                                "",
                            )
                            else None
                        ),
                    )
                )

                imported.append(
                    record.record_id
                )

            except DuplicateIntelligenceRecordError as exc:
                duplicates.append(
                    {
                        "row": row_number,
                        "error": str(exc),
                    }
                )

            except Exception as exc:
                rejected.append(
                    {
                        "row": row_number,
                        "error": str(exc),
                    }
                )

        return {
            "imported_count": len(
                imported
            ),
            "duplicate_count": len(
                duplicates
            ),
            "rejected_count": len(
                rejected
            ),
            "imported_record_ids": imported,
            "duplicates": duplicates,
            "rejected": rejected,
        }

    # ------------------------------------------------------------------
    # JSON import
    # ------------------------------------------------------------------

    def import_json(
        self,
        json_data: str | Sequence[Mapping[str, Any]],
        *,
        provider_type: str = "CURATED",
    ) -> Dict[str, Any]:
        """
        Import a JSON array of intelligence records.

        Accepts either:

            '[{...}, {...}]'

        or a Python sequence of mappings.
        """

        if isinstance(
            json_data,
            str,
        ):
            payload = json.loads(
                json_data
            )
        else:
            payload = list(
                json_data
            )

        if not isinstance(
            payload,
            list,
        ):
            raise InvalidIntelligenceRecordError(
                "JSON intelligence dataset must be an array"
            )

        imported = []
        duplicates = []
        rejected = []

        for index, row in enumerate(
            payload
        ):
            try:
                if not isinstance(
                    row,
                    Mapping,
                ):
                    raise InvalidIntelligenceRecordError(
                        "Each JSON record must be an object"
                    )

                record = (
                    self.add_intelligence_record(
                        exchange_id=row[
                            "exchange_id"
                        ],
                        address=row[
                            "address"
                        ],
                        chain=row[
                            "chain"
                        ],
                        address_type=row[
                            "address_type"
                        ],
                        classification=row[
                            "classification"
                        ],
                        source=row[
                            "source"
                        ],
                        source_reference=row[
                            "source_reference"
                        ],
                        verified_at=row[
                            "verified_at"
                        ],
                        notes=row.get(
                            "notes"
                        ),
                        provider_type=row.get(
                            "provider_type",
                            provider_type,
                        ),
                        imported_at=row.get(
                            "imported_at"
                        ),
                        confidence=row.get(
                            "confidence"
                        ),
                    )
                )

                imported.append(
                    record.record_id
                )

            except DuplicateIntelligenceRecordError as exc:
                duplicates.append(
                    {
                        "index": index,
                        "error": str(exc),
                    }
                )

            except Exception as exc:
                rejected.append(
                    {
                        "index": index,
                        "error": str(exc),
                    }
                )

        return {
            "imported_count": len(
                imported
            ),
            "duplicate_count": len(
                duplicates
            ),
            "rejected_count": len(
                rejected
            ),
            "imported_record_ids": imported,
            "duplicates": duplicates,
            "rejected": rejected,
        }

    # ------------------------------------------------------------------
    # Export
    # ------------------------------------------------------------------

    def export_json(
        self,
    ) -> str:
        """
        Export intelligence records without transaction data.
        """

        records = []

        for record in self.repository.all_records():
            item = asdict(record)

            item[
                "address_type"
            ] = record.address_type.value

            item[
                "classification"
            ] = record.classification.value

            records.append(
                item
            )

        return json.dumps(
            records,
            indent=2,
            sort_keys=True,
        )

    # ------------------------------------------------------------------
    # Evidence helpers
    # ------------------------------------------------------------------

    def _record_to_evidence(
        self,
        record: ExchangeIntelligenceRecord,
        exchange: ExchangeEntity,
    ) -> Dict[str, Any]:

        return {
            "evidence_layer": (
                EvidenceLayer
                .EXTERNAL_INTELLIGENCE_MATCH
                .value
            ),
            "exchange": {
                "exchange_id": exchange.exchange_id,
                "name": exchange.name,
                "jurisdiction": (
                    exchange.jurisdiction
                ),
            },
            "address": record.address,
            "chain": record.chain,
            "address_type": (
                record.address_type.value
            ),
            "classification": (
                record.classification.value
            ),
            "source": (
                record.provenance.source
            ),
            "source_reference": (
                record.provenance.source_reference
            ),
            "confidence": record.confidence,
            "verified_at": (
                record.provenance.verified_at
            ),
            "provenance": {
                "source": (
                    record.provenance.source
                ),
                "source_reference": (
                    record.provenance.source_reference
                ),
                "verified_at": (
                    record.provenance.verified_at
                ),
                "imported_at": (
                    record.provenance.imported_at
                ),
                "provider_type": (
