def test_intelligence_does_not_depend_on_transaction_volume():

    """
    Critical negative test.

    An address being present in a transaction dataset must NOT
    automatically create an exchange intelligence match.
    """

    service = _test_service()

    # No intelligence record exists.
    #
    # Even if an upstream blockchain engine reports that this address
    # has thousands of transactions, this service returns UNKNOWN.
    result = service.match_address(
        "0xHIGHVOLUME",
        "ethereum",
    )

    assert result[
        "matched"
    ] is False

    assert (
        result["classification"]
        == "UNKNOWN"
    )

    assert (
        result["confidence"]
        == 0.0
    )


