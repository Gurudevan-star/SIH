class ExchangeIntelligenceRecord:
    """
    External intelligence record.

    Record identity intentionally includes:

        chain
        address
        address_type
        source
        verification date

    This prevents silently treating different source claims as the
    same evidence.
    """

    exchange_id: str

    address: str
    chain: str

    address_type: AddressType

    classification: Classification

    provenance: IntelligenceProvenance

    confidence: float

    record_id: str


